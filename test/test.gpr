with "../libfyaml_ada.gpr";

project Test is

   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use
     ("test_quickstart.adb", "test_sequence.adb", "test_scalars.adb",
      "test_navigate.adb", "test_streams.adb", "test_mutate.adb",
      "test_anchors.adb", "test_parse_errors.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2012", "-gnatwa", "-gnata", "-g");
      --  -gnata: see the matching note in ../libfyaml_ada.gpr.
   end Compiler;

end Test;
